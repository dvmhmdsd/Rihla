{
  "name": "rihla",
  "version": "1.0.0",
  "private": true,
  "description": "Travel marketplace where travelers discover destinations, build multi-stop itineraries, and pay for tours and stays",
  "license": "ISC",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:psql": "docker compose exec postgres psql -U rihla -d rihla",
    "db:generate": "pnpm --filter backend db:generate",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:check": "pnpm --filter backend db:check",
    "db:studio": "pnpm --filter backend db:studio"
  },
  "devDependencies": {
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8"
  }
}
