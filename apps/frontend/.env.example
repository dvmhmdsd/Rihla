# Frontend-only env. Copy to .env.local to override.
#
# Next.js loads env files from this directory, not the monorepo root, so these
# live here rather than in the root .env (which serves docker-compose and the
# backend). Everything below has a working default in code.

# Where the NestJS API is reachable from the Next.js server.
API_URL=http://localhost:4000
