# Copy to .env and adjust. .env is gitignored; this file is committed.

# --- Postgres (consumed by docker-compose and the backend) ---
POSTGRES_USER=rihla
POSTGRES_PASSWORD=rihla
POSTGRES_DB=rihla
POSTGRES_PORT=5432

# Backend connection string. Host/port must match the mapping above.
DATABASE_URL=postgresql://rihla:rihla@localhost:5432/rihla

# --- Backend (apps/backend) ---
API_PORT=4000
# Origin allowed through CORS. Matches the Next.js dev server.
CORS_ORIGIN=http://localhost:3000

# --- Frontend (apps/frontend) ---
# Next.js reads env files from its own directory, not the repo root.
# See apps/frontend/.env.example.
